  "monotonic_assumptions": {
    "current_rainfall_24h": {
      "constraint": 1,
      "rationale": "Increasing triggering rainfall increases pore-water pressure and driving weight; cannot directly decrease slope failure probability."
    },
    "current_rainfall_p99_ratio": {
      "constraint": 1,
      "rationale": "Increasing localized extreme rainfall anomaly increases probability of exceeding physical geotechnical thresholds."
    },
    "current_rainfall_p95_ratio": {
      "constraint": 1,
      "rationale": "Higher normalized antecedent-to-peak rainfall burst increases failure hazard."
    },
    "forecast_precipitation_24h": {
      "constraint": 1,
      "rationale": "Incoming forecasted storm deluge adds prospective driving infiltration; cannot decrease upcoming 24h probability."
    },
    "forecast_rainfall_p99_ratio": {
      "constraint": 1,
      "rationale": "Normalized prospective storm intensity increases upcoming risk monotonically."
    },
    "antecedent_rainfall_48h": {
      "constraint": 1,
      "rationale": "Prior wetting saturates regolith pore space and reduces matric suction."
    },
    "rainfall_72h": {
      "constraint": 1,
      "rationale": "Cumulative 3-day rainfall promotes deep seepage and water table elevation."
    },
    "antecedent_precipitation_index": {
      "constraint": 1,
      "rationale": "Higher API represents greater residual subsurface moisture storage."
    },
    "consecutive_wet_hours": {
      "constraint": 1,
      "rationale": "Prolonged rainfall duration promotes continuous infiltration without drainage recovery."
    },
    "soil_moisture_surface": {
      "constraint": 1,
      "rationale": "Near-surface saturation induces positive pore water pressure and reduces shear strength."
    },
    "wetness_percentile": {
      "constraint": 1,
      "rationale": "Higher saturation ratio relative to field capacity decreases effective normal stress."
    },
    "dry_to_wet_transition": {
      "constraint": 1,
      "rationale": "Rapid wetting front advancement destabilizes dry cohesive bonds."
    },
    "rainfall_x_soil_wetness": {
      "constraint": 1,
      "rationale": "Coupled rainfall trigger and soil preconditioning compounds destabilization."
    },
    "slope_angle": {
      "constraint": 1,
      "rationale": "Steeper slope increases tangential gravitational driving shear stress along prospective failure planes."
    },
    "susceptibility_prior": {
      "constraint": 1,
      "rationale": "Higher intrinsic geological susceptibility cannot decrease operational failure probability."
    },
    "lineament_density": {
      "constraint": 1,
      "rationale": "Higher structural fracture density facilitates infiltration and creates shear weakness planes."
    },
    "lithology_strength": {
      "constraint": -1,
      "rationale": "Higher intact rock strength resists shear failure and reduces failure probability."
    },
    "distance_to_active_fault": {
      "constraint": -1,
      "rationale": "Greater distance from active seismotectonic faults reduces seismic fracture damage."
    },
    "distance_to_road": {
      "constraint": -1,
      "rationale": "Greater distance from road cuts reduces destabilizing toe excavation."
    },
    "ndvi": {
      "constraint": -1,
      "rationale": "Higher vegetation and root reinforcement enhances slope cohesion and evapotranspiration."
    }
  }
